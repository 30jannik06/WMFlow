# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# NextAuth / Discord Admin
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# Production URL — required for NextAuth to generate correct callback URLs
# Must match the domain used in Discord OAuth redirect URIs
AUTH_URL="https://yourdomain.com"

# Discord OAuth App — https://discord.com/developers/applications
# Register ALL of these as redirect URIs in Discord Dev Portal:
#   https://yourdomain.com/api/auth/callback/discord
#   https://www.yourdomain.com/api/auth/callback/discord
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# true  = jeder Discord-Login wird als Admin gespeichert (einmalig zum Registrieren)
# false = nur bereits registrierte Admins kommen rein
ADMIN_REGISTRATION_OPEN="false"

# API-Football — https://www.api-football.com
# Free: 100 Req/Tag (Testing + Mapping), Pro $19/Mo: 7.500/Tag (WM-Monat)
API_FOOTBALL_KEY="your-api-football-key"

# Vercel Cron Secret — schützt /api/cron/live vor fremden Aufrufen
# Generieren: openssl rand -base64 32
CRON_SECRET="your-cron-secret"
