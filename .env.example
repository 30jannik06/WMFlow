# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# NextAuth / Discord Admin
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# Discord OAuth App — https://discord.com/developers/applications
# Redirect URI: https://yourdomain.com/api/auth/callback/discord
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# true  = jeder Discord-Login wird als Admin gespeichert (einmalig zum Registrieren)
# false = nur bereits registrierte Admins kommen rein
ADMIN_REGISTRATION_OPEN="false"
